/* 全局字体和文字颜色 */
QWidget {
   font-family: "Roboto", "Segoe UI", sans-serif;
   font-size: 12px;
   color: #ffffff;
   background-color:#424242;
}

/* 悬停状态（注意英文冒号且无空格） */
QToolButton:hover {
   background-color: #353535;
   border: none;
   padding: 8px;
}

/* 按下状态 */
QToolButton:pressed {
   background-color: #9e9e9e;
}

QLabel {
    color: #ffffff;
}